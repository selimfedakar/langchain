    {
      "id": "claim_33d856cb74d0404f8164c01fe718c3e6",
      "statement": "invoke(input, config, *, stop, **kwargs) → AIMessage is the synchronous single-call method that converts input via _convert_input(), calls generate_prompt() on a single-element prompt list, extracts the first ChatGeneration, and returns its AIMessage payload.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L516-L540",
