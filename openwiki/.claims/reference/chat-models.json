    {
      "id": "claim_99213db63b1146428980da59561e8aa7",
      "statement": "disable_streaming field (bool | Literal['tool_calling']) controls streaming suppression: True always bypasses streaming, 'tool_calling' bypasses only when tools are bound, False (default) uses streaming if available; checked via _streaming_disabled() to gate _should_stream() and _should_use_protocol_streaming().",
      "evidence": [
