    {
      "id": "claim_8c286dddce9945b6aae85a4350e260b6",
      "statement": "stream_events() supports three versions: v1 (legacy callback-based events), v2 (default protocol events with richer structure via _should_use_protocol_streaming routing through _iter_v2_events/_aiter_v2_events which prefer native _stream_chat_model_events hooks or bridge _stream chunks via chunks_to_events), and v3 (beta content-block-centric via _chat_model_stream_v3/_achat_model_stream_v3 returning ChatModelStream/AsyncChatModelStream with typed projections).",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L1040-L1176",
