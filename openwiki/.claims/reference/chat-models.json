    {
      "id": "claim_1e14cb5950bd4c2bbfd1fd4024487983",
      "statement": "with_structured_output(schema: dict | type, include_raw=False, **kwargs) → Runnable enforces schema-based responses via binding the schema as a single tool with tool_choice='any', invoking the bound model, and parsing tool arguments through JsonOutputToolsParser or PydanticToolsParser, returning parsed output or {'raw': message, 'parsed': result, 'parsing_error': exception} if include_raw=True.",
      "evidence": [
