        }
      ]
    },
    {
      "id": "claim_f568d564a261477893967deeaaaea268",
      "statement": "_generate(messages, stop, run_manager, **kwargs) → ChatResult is the abstract method that subclasses must implement, receiving normalized BaseMessage lists and returning ChatResult with ChatGeneration objects containing AIMessage and optional provider-specific llm_output; complemented by optional async (_agenerate), streaming (_stream, _astream), and native event hook (_stream_chat_model_events, _astream_chat_model_events) overrides for optimized paths.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L2251-L2355",
          "version": "repo-lines-v1:sha256:307aad31924a22f0eb60a7d2c83ae704e9a713e8bb6af29a255709f693cfe02b:"
        }
      ]
    },
    {
      "id": "claim_dbcf54e8d3f04497aa24f440c3de9247",
      "statement": "_llm_type property is an abstract string identifier (e.g., 'openai', 'anthropic') required for logging, serialization, and model discovery, used in traces and model selection.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L2372-L2375",
          "version": "repo-lines-v1:sha256:db535b12ac0a27fd6314901aaffafb6168ea80a9f313f96f7f93ffed50846b76:"
        }
      ]
    },
    {
      "id": "claim_4d162ca871f84429849b3ef38b9b46d2",
      "statement": "Message input conversion via _convert_input() normalizes three input forms—bare strings to StringPromptValue, message lists to ChatPromptValue, and existing PromptValues passed through—then calls _normalize_messages() to ensure consistent internal BaseMessage representation before reaching _generate().",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L502-L513",
          "version": "repo-lines-v1:sha256:24287b0abdaea0feab7ef708f33a5c3586ce8ca68f42123671e789ee6437258d:"
