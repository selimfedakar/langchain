    {
      "id": "claim_91a34babfce04e519d78aca511eca8b9",
      "statement": "generate(messages: list[list[BaseMessage]], stop, callbacks, **kwargs) → LLMResult processes multiple message sequences by iterating through _generate_with_cache() for each, combines results via _combine_llm_outputs(), fires on_chat_model_start() once with batch_size, and dispatches per-batch on_llm_end()/on_llm_error() callbacks.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L1635-L1759",
          "version": "repo-lines-v1:sha256:10713381eddb3932f6ee9ae086bc1e0e35fde2b65c37de93be4f7d5fa361ff20:"
        }
      ]
    },
    {
      "id": "claim_dfd460abc2d94afcba6dc196ebbbfab4",
      "statement": "agenerate() is the async counterpart to generate(), concurrently invoking _agenerate_with_cache() for each message list via asyncio.gather() with return_exceptions=True to collect failures alongside successes.",
      "evidence": [
        {
          "resource": "repo://libs/core/langchain_core/language_models/chat_models.py#L1761-L1909",
          "version": "repo-lines-v1:sha256:f4304f6ddc44aee6a4ec1f81b165dea18be17bc0077e61b0c0f4e0d4d857b4f7:"
        }
